FLASK_ENV=development
# Keep off for demonstrations. Enable only during local debugging.
FLASK_DEBUG=0
# Local access only. Change explicitly if another machine must connect.
HOST=127.0.0.1
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=mysql+pymysql://spaza_user:spaza_password@localhost:3306/spaza_inventory
LOG_LEVEL=INFO

